# Im Repository immer LF, im Arbeitsverzeichnis was das System will.
* text=auto eol=lf

*.php text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.svg text eol=lf

# Binärdateien nicht anfassen.
*.png binary

# Nicht ins Release-ZIP und nicht in ein Export-Archiv.
/.gitattributes export-ignore
/.gitignore    export-ignore
